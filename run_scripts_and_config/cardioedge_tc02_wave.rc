Magic 271485
; Window Layout <x> <y> <width> <height> <signalwidth> <valuewidth>
viewPort 0 28 1400 850 380 120

; File list:
openDirFile -d / "" "cardioedge_tc02.fsdb"

; signal spacing:
signalSpacing 5

; windowTimeUnit is used for zoom, cursor & marker
windowTimeUnit 1ps

; toolbar current search type
curSTATUS ByChange

; user define markers for each test case
userMarker 0 "TC-01: CPU Boot & Reset" ID_GREEN5 1
userMarker 1970000 "TC-02: Memory & ISA" ID_GREEN5 1
userMarker 17550000 "TC-03: AXI Mapping & Handshakes" ID_GREEN5 1
userMarker 18570000 "TC-04: Master Arbitration" ID_GREEN5 1
userMarker 19590000 "TC-05: UART Subsystem" ID_GREEN5 1
userMarker 41370000 "TC-06: GPIO Subsystem" ID_GREEN5 1
userMarker 41590000 "TC-07: 32-Bit Timer" ID_GREEN5 1
userMarker 49030000 "TC-08: FIR Golden Model" ID_GREEN5 1
userMarker 58090000 "TC-09: ADC Interface & Overrun" ID_GREEN5 1
userMarker 64930000 "TC-10: SPI Master Loopback" ID_GREEN5 1
userMarker 73390000 "TC-11: QRS Detection Engine" ID_GREEN5 1
userMarker 84750000 "TC-12: Rhythm & Heart Rate" ID_GREEN5 1
userMarker 85170000 "TC-13: Dummy Slave DECERR" ID_GREEN5 1
userMarker 89970000 "TC-14: Interrupts & PIC" ID_GREEN5 1
userMarker 90010000 "TC-15: Firmware Telemetry" ID_GREEN5 1
userMarker 90050000 "TC-16: End-to-End Pipeline" ID_GREEN5 1
userMarker 97690000 "TC-17: Reset Recovery" ID_GREEN5 1
userMarker 98330000 "TC-18: Regression Scorecard" ID_GREEN5 1

addGroup "G1: TC-01..TC-18 Test Markers & C Mailbox"
activeDirFile "" "cardioedge_tc02.fsdb"
addSignal -h 15 -UNSIGNED -DEC /tb_cardioedge_comprehensive_soc/test_id[31:0]
addSignal -h 15 -ASCII /tb_cardioedge_comprehensive_soc/test_name[255:0]
addSignal -h 15 -ASCII /tb_cardioedge_comprehensive_soc/test_state[63:0]
addSignal -h 15 -UNSIGNED -BIN /tb_cardioedge_comprehensive_soc/test_status[1:0]
addSignal -h 15 /tb_cardioedge_comprehensive_soc/test_start_marker
addSignal -h 15 /tb_cardioedge_comprehensive_soc/test_done_marker
addSignal -h 15 -UNSIGNED -DEC /tb_cardioedge_comprehensive_soc/fw_test_id[31:0]
addSignal -h 15 -ASCII /tb_cardioedge_comprehensive_soc/fw_test_state[63:0]
addSignal -h 15 -UNSIGNED -BIN /tb_cardioedge_comprehensive_soc/fw_test_status[1:0]
addSignal -h 15 /tb_cardioedge_comprehensive_soc/fw_start_marker
addSignal -h 15 /tb_cardioedge_comprehensive_soc/fw_done_marker
addSignal -h 15 -ASCII /tb_cardioedge_comprehensive_soc/overall_test_state[63:0]
addSignal -h 15 -UNSIGNED -HEX /tb_cardioedge_comprehensive_soc/fw_extra_telemetry[31:0]

addGroup "G2: SoC Clocks & Reset (TC-01, TC-17)"
addSignal -h 15 /tb_cardioedge_comprehensive_soc/clk
addSignal -h 15 /tb_cardioedge_comprehensive_soc/rst_n
addSignal -h 15 /tb_cardioedge_comprehensive_soc/dut/rst
addSignal -h 15 /tb_cardioedge_comprehensive_soc/dut/aresetn

addGroup "G3: VeeR EL2 CPU Core & ISA (TC-01, TC-02, TC-15, TC-17)"
